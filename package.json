{
  "name": "powerpoint-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "قالب عرض تقديمي مهيكل: عنوان ← مقدمة ← خريطة ← فصول/شرائح ← خاتمة (React + Vite + TypeScript + Tailwind)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
